rectangle "Смартфон оператора\n<size:16>[Deployment Node: React Native (Expo)]</size>" <<DeploymentNode-RWxlbWVudA==>> as Production.Смартфоноператора {
  rectangle "==Shift Screens\n<size:16>[Container: React Native]</size>\n\nShiftReport, BatteryInventory, ScooterIssues" <<Element-RWxlbWVudCxDb250YWluZXIsRnJvbnRlbmQ=>> as Production.Смартфоноператора.ShiftScreens_1
  rectangle "==Sync Engine\n<size:16>[Container: React Native]</size>\n\nОчередь операций (SQLite), retry, client_op_id (UUID), сверка со сменой" <<Element-RWxlbWVudCxDb250YWluZXIsRnJvbnRlbmQ=>> as Production.Смартфоноператора.SyncEngine_1
  rectangle "==Media Capture\n<size:16>[Container: React Native (Camera)]</size>\n\nQR-идентификация, фото в MinIO" <<Element-RWxlbWVudCxDb250YWluZXIsRnJvbnRlbmQ=>> as Production.Смартфоноператора.MediaCapture_1
  database "==Local Store\n<size:16>[Container: SQLite]</size>\n\nЗадачи, черновики отчётов, очередь фото" <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YVN0b3Jl>> as Production.Смартфоноператора.LocalStore_1
}

