@startuml
title <size:24>Dynamic View: Scooter Rental Platform</size>\n<size:24>Бот создаёт обращение в поддержку</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: transparent;
    FontColor: #8b949e;
  }
  // Element,Container,DataStore
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YVN0b3Jl {
    BackgroundColor: #7d4e00;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Frontend
  .Element-RWxlbWVudCxDb250YWluZXIsRnJvbnRlbmQ= {
    BackgroundColor: #0d419d;
    LineColor: #58a6ff;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Infra
  .Element-RWxlbWVudCxDb250YWluZXIsSW5mcmE= {
    BackgroundColor: #1f2937;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Messaging
  .Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnaW5n {
    BackgroundColor: #7d4e00;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Microservice
  .Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl {
    BackgroundColor: #0d419d;
    LineColor: #58a6ff;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person,Bot
  .Element-RWxlbWVudCxQZXJzb24sQm90 {
    BackgroundColor: #1e3a5f;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person,Support
  .Element-RWxlbWVudCxQZXJzb24sU3VwcG9ydA== {
    BackgroundColor: #1e3a5f;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw= {
    BackgroundColor: #6e40c9;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #8b949e;
    FontColor: #8b949e;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Scooter Rental Platform
  .Boundary-U2Nvb3RlciBSZW50YWwgUGxhdGZvcm0= {
    BackgroundColor: #161b22;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Scooter Rental Platform\n<size:16>[Software System]</size>" <<Boundary-U2Nvb3RlciBSZW50YWwgUGxhdGZvcm0=>> {
  rectangle "==Operator App\n<size:16>[Container: React Native]</size>\n\nЗадачи АКБ, QR + фото, ShiftReport/Inventory/Issues, offline-first" <<Element-RWxlbWVudCxDb250YWluZXIsRnJvbnRlbmQ=>> as ScooterRentalPlatform.OperatorApp
  rectangle "==Ingress (NGINX)\n<size:16>[Container: NGINX Ingress]</size>\n\nTLS-терминация, rate limiting, маршрутизация (без авторизации)" <<Element-RWxlbWVudCxDb250YWluZXIsSW5mcmE=>> as ScooterRentalPlatform.IngressNGINX
  rectangle "==Support Service\n<size:16>[Container: Rust + Axum]</size>\n\nТикеты, ручные возвраты" <<Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl>> as ScooterRentalPlatform.SupportService
  rectangle "==Bot Service\n<size:16>[Container: Rust + Axum]</size>\n\n100 эмуляторов, случайное поведение, эмуляция платежей" <<Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl>> as ScooterRentalPlatform.BotService
  rectangle "==Notification Service\n<size:16>[Container: Rust + Axum]</size>\n\nУведомления через Telegram Bot API" <<Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl>> as ScooterRentalPlatform.NotificationService
  database "==PostgreSQL\n<size:16>[Container: PostgreSQL 16]</size>\n\nSource of truth (в т.ч. брони), по схеме на сервис" <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YVN0b3Jl>> as ScooterRentalPlatform.PostgreSQL
  queue "==Kafka\n<size:16>[Container: Kafka]</size>\n\nДоменные события, KRaft-режим" <<Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnaW5n>> as ScooterRentalPlatform.Kafka
}

person "==Бот-арендатор\n<size:16>[Person]</size>\n\nЭмулирует пользователей, создаёт обращения в поддержку" <<Element-RWxlbWVudCxQZXJzb24sQm90>> as Ботарендатор
person "==Админ поддержки\n<size:16>[Person]</size>\n\nТикеты, ручные возвраты" <<Element-RWxlbWVudCxQZXJzb24sU3VwcG9ydA==>> as Админподдержки
rectangle "==Telegram Platform\n<size:16>[Software System]</size>\n\nХостинг Mini App, Bot API для уведомлений" <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as TelegramPlatform

Ботарендатор --> ScooterRentalPlatform.BotService <<Relationship-UmVsYXRpb25zaGlw>> : "1: Эмулирует аренду и ошибки\n<size:16>[HTTPS + API Key]</size>"
ScooterRentalPlatform.BotService --> ScooterRentalPlatform.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "2: support.ticket.created.v1\n<size:16>[Kafka]</size>"
ScooterRentalPlatform.Kafka --> ScooterRentalPlatform.SupportService <<Relationship-UmVsYXRpb25zaGlw>> : "3: Тикеты от ботов и пользователей\n<size:16>[Kafka]</size>"
ScooterRentalPlatform.SupportService --> ScooterRentalPlatform.PostgreSQL <<Relationship-UmVsYXRpb25zaGlw>> : "4: Тикеты, ручные возвраты\n<size:16>[SQL]</size>"
Админподдержки --> ScooterRentalPlatform.OperatorApp <<Relationship-UmVsYXRpb25zaGlw>> : "5: Обрабатывает тикеты (роль поддержки)\n<size:16>[HTTPS]</size>"
ScooterRentalPlatform.OperatorApp --> ScooterRentalPlatform.IngressNGINX <<Relationship-UmVsYXRpb25zaGlw>> : "6: REST API\n<size:16>[HTTPS/JSON]</size>"
ScooterRentalPlatform.IngressNGINX --> ScooterRentalPlatform.SupportService <<Relationship-UmVsYXRpb25zaGlw>> : "7: Маршрутизация /tickets\n<size:16>[HTTPS/JSON]</size>"
ScooterRentalPlatform.Kafka --> ScooterRentalPlatform.NotificationService <<Relationship-UmVsYXRpb25zaGlw>> : "8: Триггеры: аренда, бронь, задачи\n<size:16>[Kafka]</size>"
ScooterRentalPlatform.NotificationService --> TelegramPlatform <<Relationship-UmVsYXRpb25zaGlw>> : "9: Сообщения через Bot API\n<size:16>[HTTPS]</size>"

@enduml