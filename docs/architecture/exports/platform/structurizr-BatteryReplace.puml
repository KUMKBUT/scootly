@startuml
title <size:24>Dynamic View: Scooter Rental Platform</size>\n<size:24>Замена аккумулятора оператором</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: transparent;
    FontColor: #8b949e;
  }
  // Element,Container,DataStore
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YVN0b3Jl {
    BackgroundColor: #7d4e00;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Frontend
  .Element-RWxlbWVudCxDb250YWluZXIsRnJvbnRlbmQ= {
    BackgroundColor: #0d419d;
    LineColor: #58a6ff;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Infra
  .Element-RWxlbWVudCxDb250YWluZXIsSW5mcmE= {
    BackgroundColor: #1f2937;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Messaging
  .Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnaW5n {
    BackgroundColor: #7d4e00;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Microservice
  .Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl {
    BackgroundColor: #0d419d;
    LineColor: #58a6ff;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #1e3a5f;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #8b949e;
    FontColor: #8b949e;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Scooter Rental Platform
  .Boundary-U2Nvb3RlciBSZW50YWwgUGxhdGZvcm0= {
    BackgroundColor: #161b22;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Scooter Rental Platform\n<size:16>[Software System]</size>" <<Boundary-U2Nvb3RlciBSZW50YWwgUGxhdGZvcm0=>> {
  rectangle "==Operator App\n<size:16>[Container: React Native]</size>\n\nЗадачи АКБ, QR + фото, ShiftReport/Inventory/Issues, offline-first" <<Element-RWxlbWVudCxDb250YWluZXIsRnJvbnRlbmQ=>> as ScooterRentalPlatform.OperatorApp
  rectangle "==Ingress (NGINX)\n<size:16>[Container: NGINX Ingress]</size>\n\nTLS-терминация, rate limiting, маршрутизация (без авторизации)" <<Element-RWxlbWVudCxDb250YWluZXIsSW5mcmE=>> as ScooterRentalPlatform.IngressNGINX
  rectangle "==Geo Service\n<size:16>[Container: Rust + Axum]</size>\n\nГеозоны, nearby, радиус оператора 10 м" <<Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl>> as ScooterRentalPlatform.GeoService
  rectangle "==Operator Service\n<size:16>[Container: Rust + Axum]</size>\n\nАвтозадачи при заряде <20%, смены, инвентарь АКБ" <<Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl>> as ScooterRentalPlatform.OperatorService
  rectangle "==Notification Service\n<size:16>[Container: Rust + Axum]</size>\n\nУведомления через Telegram Bot API" <<Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl>> as ScooterRentalPlatform.NotificationService
  database "==PostgreSQL\n<size:16>[Container: PostgreSQL 16]</size>\n\nSource of truth (в т.ч. брони), по схеме на сервис" <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YVN0b3Jl>> as ScooterRentalPlatform.PostgreSQL
  queue "==Kafka\n<size:16>[Container: Kafka]</size>\n\nДоменные события, KRaft-режим" <<Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnaW5n>> as ScooterRentalPlatform.Kafka
  database "==MinIO (S3)\n<size:16>[Container: S3-compatible]</size>\n\nФото замены АКБ: сырые 90 дней, thumbnails бессрочно" <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YVN0b3Jl>> as ScooterRentalPlatform.MinIOS3
}

person "==Оператор\n<size:16>[Person]</size>\n\nЗамена АКБ, задачи, закрытие смены (RN-приложение, offline-first)" <<Element-RWxlbWVudCxQZXJzb24=>> as Оператор

ScooterRentalPlatform.Kafka --> ScooterRentalPlatform.OperatorService <<Relationship-UmVsYXRpb25zaGlw>> : "1: Заряд <20%, задачи диспетчера\n<size:16>[Kafka]</size>"
ScooterRentalPlatform.OperatorService --> ScooterRentalPlatform.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "2: task.assigned.v1, task.completed.v1, shift.closed.v1\n<size:16>[Kafka]</size>"
Оператор --> ScooterRentalPlatform.OperatorApp <<Relationship-UmVsYXRpb25zaGlw>> : "3: Берёт задачи, сканирует QR, грузит фото\n<size:16>[HTTPS]</size>"
ScooterRentalPlatform.OperatorApp --> ScooterRentalPlatform.IngressNGINX <<Relationship-UmVsYXRpb25zaGlw>> : "4: REST API\n<size:16>[HTTPS/JSON]</size>"
ScooterRentalPlatform.IngressNGINX --> ScooterRentalPlatform.OperatorService <<Relationship-UmVsYXRpb25zaGlw>> : "5: Маршрутизация /tasks\n<size:16>[HTTPS/JSON]</size>"
ScooterRentalPlatform.OperatorService --> ScooterRentalPlatform.GeoService <<Relationship-UmVsYXRpb25zaGlw>> : "6: Проверка радиуса 10 м\n<size:16>[gRPC]</size>"
ScooterRentalPlatform.OperatorService --> ScooterRentalPlatform.PostgreSQL <<Relationship-UmVsYXRpb25zaGlw>> : "7: Задачи, смены, инвентарь АКБ\n<size:16>[SQL]</size>"
ScooterRentalPlatform.OperatorApp --> ScooterRentalPlatform.MinIOS3 <<Relationship-UmVsYXRpb25zaGlw>> : "8: Загрузка фото замены (presigned S3, client_op_id)\n<size:16>[HTTPS (S3)]</size>"
ScooterRentalPlatform.OperatorService --> ScooterRentalPlatform.Kafka <<Relationship-UmVsYXRpb25zaGlw>> : "9: task.assigned.v1, task.completed.v1, shift.closed.v1\n<size:16>[Kafka]</size>"
ScooterRentalPlatform.Kafka --> ScooterRentalPlatform.NotificationService <<Relationship-UmVsYXRpb25zaGlw>> : "10: Триггеры: аренда, бронь, задачи\n<size:16>[Kafka]</size>"

@enduml