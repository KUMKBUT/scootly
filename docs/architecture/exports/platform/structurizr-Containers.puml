@startuml
title <size:24>Container View: Scooter Rental Platform</size>\n<size:24>Микросервисы, клиенты и инфраструктура</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: transparent;
    FontColor: #8b949e;
  }
  // Element,Container,DataStore
  .Element-RWxlbWVudCxDb250YWluZXIsRGF0YVN0b3Jl {
    BackgroundColor: #7d4e00;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Frontend
  .Element-RWxlbWVudCxDb250YWluZXIsRnJvbnRlbmQ= {
    BackgroundColor: #0d419d;
    LineColor: #58a6ff;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Infra
  .Element-RWxlbWVudCxDb250YWluZXIsSW5mcmE= {
    BackgroundColor: #1f2937;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Messaging
  .Element-RWxlbWVudCxDb250YWluZXIsTWVzc2FnaW5n {
    BackgroundColor: #7d4e00;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Microservice
  .Element-RWxlbWVudCxDb250YWluZXIsTWljcm9zZXJ2aWNl {
    BackgroundColor: #0d419d;
    LineColor: #58a6ff;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Monitoring
  .Element-RWxlbWVudCxDb250YWluZXIsTW9uaXRvcmluZw== {
    BackgroundColor: #1f2937;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    RoundCorner: 20;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #1e3a5f;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person,Bot
  .Element-RWxlbWVudCxQZXJzb24sQm90 {
    BackgroundColor: #1e3a5f;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person,Support
  .Element-RWxlbWVudCxQZXJzb24sU3VwcG9ydA== {
    BackgroundColor: #1e3a5f;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw= {
    BackgroundColor: #6e40c9;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External,IoT
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsSW9U {
    BackgroundColor: #7d4e00;
    LineColor: #30363d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #e6edf3;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #8b949e;
    FontColor: #8b949e;
    FontSize: 24;
    MaximumWidth: 200;
  }
  // Scooter Rental Platform
  .Boundary-U2Nvb3RlciBSZW50YWwgUGxhdGZvcm0= {
    BackgroundColor: #161b22;
    LineColor: #30363d;
    LineStyle: 0;
