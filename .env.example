# Postgres
POSTGRES_USER=scootly
POSTGRES_PASSWORD=scootly
POSTGRES_DB=scootly
POSTGRES_PORT=5432
DATABASE_URL=postgres://scootly:scootly@localhost:5432/scootly

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:29092

# Geo: fallback last_position по gRPC (ADR-0011)
SCOOTER_SERVICE_URL=http://localhost:9001

# MinIO (S3 для фото) + бэкапы
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
S3_BACKUP_BUCKET=scootly-backups

# Auth
JWT_SECRET=change-me-in-production

# Тариф per_minute (MVP #4): копейки, фикс разблокировки + цена минуты (ADR-0016)
TARIFF_UNLOCK_KOPEKS=2900
TARIFF_PER_MIN_KOPEKS=800
# На сколько минут берётся холд (MVP #5, ADR-0003)
TARIFF_HOLD_MINUTES=60

# Оплата (MVP #5): rental-service -> payment-service по gRPC (ADR-0003/0014).
# Без переменной rental-service работает с эмуляцией оплаты.
PAYMENT_SERVICE_URL=http://localhost:9001
# Джоб сверки capture (ADR-0003), секунд
RECONCILIATION_INTERVAL_SECS=300
# YooKassa (пока эмуляция: ключи не требуются; секреты - только через env)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=0000000000:changeme

# Observability / misc
RUST_LOG=info
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
